      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Responde SOLO con JSON, sin explicaciones, sin texto adicional, sin markdown.\n\nClasifica este mensaje en una de estas herramientas: clima, paises, wikipedia, ninguna.\n\nEJEMPLOS:\nMensaje: \"que tiempo hace en barcelona\" → {\"herramienta\":\"clima\",\"parametros\":{\"ciudad\":\"barcelona\"},\"razon\":\"pregunta clima\"}\nMensaje: \"capital de francia\" → {\"herramienta\":\"paises\",\"parametros\":{\"pais\":\"france\"},\"razon\":\"pregunta pais\"}\nMensaje: \"quien fue napoleon\" → {\"herramienta\":\"wikipedia\",\"parametros\":{\"query\":\"napoleon\"},\"razon\":\"pregunta wikipedia\"}\nMensaje: \"hola como estas\" → {\"herramienta\":\"ninguna\",\"parametros\":{},\"razon\":\"saludo\"}\nMensaje: \"busca en wikipedia japon\" → {\"herramienta\":\"wikipedia\",\"parametros\":{\"query\":\"japon\"},\"razon\":\"busqueda wikipedia\"}\n\nMensaje a clasificar: {{ $('Validar Input').item.json.mensaje }}\n\nJSON:",
        "options": {}
      },
