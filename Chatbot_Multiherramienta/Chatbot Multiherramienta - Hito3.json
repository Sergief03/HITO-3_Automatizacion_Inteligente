    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst mensaje = body.mensaje || body.message || '';\nconst sessionId = body.session_id || body.sessionId || 'default-session';\n\nif (!mensaje.trim()) {\n  throw new Error('El campo mensaje es obligatorio');\n}\n\nreturn [{\n  json: {\n    mensaje: mensaje.trim(),\n    sessionId: sessionId,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "daffe203-56c6-42e8-ba0b-d03051977306",
      "name": "Validar Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        848
      ]
    },
    {
      "parameters": {
        "jsCode": "const inputData = $('Validar Input').item.json;\n\n// El agente devuelve array - buscar el primer item con JSON válido en 'output'\nconst items = $input.all();\nlet clasificacion = { herramienta: 'ninguna', parametros: {}, razon: '' };\n\nfor (const item of items) {\n  const raw = item.json.output || item.json.text || item.json.response || '';\n  try {\n    const parsed = JSON.parse(raw.trim());\n    if (parsed.herramienta && parsed.herramienta !== 'ninguna') {\n      clasificacion = parsed;\n      break; // Encontrado, salir del bucle\n    }\n  } catch(e) {\n    continue;\n  }\n}\n\nreturn [{\n  json: {\n    mensaje:             inputData.mensaje,\n    session_id:          inputData.session_id,\n    timestamp:           inputData.timestamp,\n    herramienta:         clasificacion.herramienta  || 'ninguna',\n    parametros:          clasificacion.parametros   || {},\n    razon_clasificacion: clasificacion.razon        || ''\n  }\n}];"
      },
      "id": "d6f1e8d0-53f1-4f6b-bf95-b5806857241c",
      "name": "Parsear Intencion",
