    {
      "parameters": {
        "jsCode": "const inputData = $('Validar Input').item.json;\nconst intencion = $('Parsear Intencion').item.json;\n\nconst agentOutput = $('Chain Generar Respuesta').item.json;\nlet respuesta = agentOutput.output || agentOutput.text || agentOutput.response || 'No se pudo generar respuesta.';\n\n// Eliminar el razonamiento interno del modelo (todo lo que va antes del contenido real)\n// El modelo suele terminar el razonamiento con ** o con un salto doble\nconst separadores = [\n  /\\*\\*Japón[\\s\\S]*/,        // Buscar inicio del contenido real con **\n  /\\n\\n([^*\\n].+[\\s\\S]*)/,  // Primer párrafo real tras línea en blanco\n];\n\nfor (const sep of separadores) {\n  const match = respuesta.match(sep);\n  if (match) {\n    respuesta = match[0].trim();\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    ok: true,\n    session_id:        inputData.session_id,\n    mensaje_usuario:   inputData.mensaje,\n    respuesta:         respuesta.trim(),\n    herramienta_usada: intencion.herramienta || 'ninguna',\n    timestamp:         new Date().toISOString()\n  }\n}];"
      },
