    {
      "parameters": {
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.geo.lat }}&longitude={{ $json.geo.lon }}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code,apparent_temperature&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&timezone=auto&forecast_days=3",
        "options": {}
      },
      "id": "ff635edb-687c-47bd-a1ac-98ccfe312c8d",
      "name": "API OpenMeteo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        848,
        608
      ]
    },
    {
      "parameters": {
        "jsCode": "const clima = $json;\nconst geo = $('Extraer Coordenadas').item.json.geo;\nconst inputData = $('Parsear Intencion').item.json;\n\nconst wmo = {0:'Despejado',1:'Mayormente despejado',2:'Parcialmente nublado',3:'Nublado',45:'Niebla',51:'Llovizna leve',61:'Lluvia leve',63:'Lluvia moderada',65:'Lluvia intensa',71:'Nieve leve',80:'Chubascos',95:'Tormenta',99:'Tormenta con granizo'};\n\nconst c = clima.current;\nconst d = clima.daily;\nconst estado = wmo[c.weather_code] || ('Codigo ' + c.weather_code);\n\nconst contexto = 'Ciudad: ' + geo.nombre + ', ' + geo.pais + '\\nTemperatura: ' + c.temperature_2m + 'C (sensacion ' + c.apparent_temperature + 'C)\\nViento: ' + c.wind_speed_10m + ' km/h\\nHumedad: ' + c.relative_humidity_2m + '%\\nEstado: ' + estado + '\\nProximos 3 dias:\\n- Hoy: ' + d.temperature_2m_min[0] + 'C - ' + d.temperature_2m_max[0] + 'C | Lluvia: ' + d.precipitation_sum[0] + 'mm\\n- Manana: ' + d.temperature_2m_min[1] + 'C - ' + d.temperature_2m_max[1] + 'C | Lluvia: ' + d.precipitation_sum[1] + 'mm\\n- Pasado: ' + d.temperature_2m_min[2] + 'C - ' + d.temperature_2m_max[2] + 'C | Lluvia: ' + d.precipitation_sum[2] + 'mm';\n\nreturn [{\n  json: {\n    mensaje: inputData.mensaje,\n    session_id: inputData.session_id,\n    herramienta: inputData.herramienta,\n    contexto_api: contexto\n  }\n}];"
      },
      "id": "3f5e2a34-95e6-4d12-b10b-68ae0b2e3d09",
      "name": "Formatear Clima",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
