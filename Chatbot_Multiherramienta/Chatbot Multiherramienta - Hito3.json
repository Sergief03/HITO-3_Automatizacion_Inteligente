      "parameters": {
        "jsCode": "const data = $json;\nconst inputData = $('Parsear Intencion').item.json;\n\nif (!data.results || data.results.length === 0) {\n  throw new Error('Ciudad no encontrada: ' + (inputData.parametros.ciudad || 'desconocida'));\n}\n\nconst loc = data.results[0];\n\nreturn [{\n  json: {\n    mensaje:     inputData.mensaje,\n    session_id:  inputData.session_id,\n    herramienta: inputData.herramienta,\n    parametros:  inputData.parametros,\n    geo: {\n      nombre: loc.name,\n      pais:   loc.country,\n      lat:    loc.latitude,\n      lon:    loc.longitude\n    }\n  }\n}];"
